rules_version = '2';

// Every customer can only see and change their own data.
// Server API routes use the Firebase Admin SDK, which bypasses these rules, so the
// browser never needs broader access than this.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The server's own identity when it runs WITHOUT a service-account key ("server login", DEPLOYMENT_GUIDE.md): paste the
    // Firebase Authentication user id (UID) of the dedicated server user between the quotes, then republish these rules.
    // Left as it is, it matches nobody, so the rules stay exactly as locked down as before.
    function isServer() { return request.auth != null && request.auth.uid == 'PASTE_SERVER_USER_UID_HERE'; }
    function uid() { return request.auth.uid; }

    // A document belongs to the caller if it says so, or its id is "<uid>_<something>".
    function ownsExisting(docId) {
      return signedIn() && (
        resource.data.get('userId', '') == uid() ||
        resource.data.get('createdBy', '') == uid() ||
        docId.matches('^' + uid() + '_.*')
      );
    }
    function ownsNew(docId) {
      return signedIn() && (
        request.resource.data.get('userId', '') == uid() ||
        request.resource.data.get('createdBy', '') == uid() ||
        docId.matches('^' + uid() + '_.*')
      );
    }

    // The dedicated server user (server login) may read and write everything. Nobody else gets anything from this.
    match /{document=**} {
      allow read, write: if isServer();
    }

    // Everything under users/{uid}/... (settings, follow-up tasks, notes, contacts)
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      match /{sub=**} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Collections the signed-in user reads and writes directly from the browser.
    match /{coll}/{docId} {
      allow read, delete: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox', 'suppressions',
          'draft_queue', 'autopilot_users', 'inbound_enquiries', 'reply_notices', 'finder_jobs'
        ] && ownsExisting(docId);

      // 'suppressions' (opt-outs), 'draft_queue' (prepared drafts), 'autopilot_users' and 'inbound_enquiries' (public form submissions) and 'reply_notices', 'finder_jobs' (the lead finder's queue: the server fetches from it, so no browser may edit it), 'tenants' (plan standing) and 'admin_audit' (operator actions) are deliberately NOT in the create/update lists below: only the server writes them.
      allow create: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox'
        ] && ownsNew(docId);

      // Updates may not hand the document to somebody else.
      allow update: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox'
        ] && ownsExisting(docId) && ownsNew(docId);

      // AI usage is written only by the server and is READ-ONLY for users. Letting a user
      // delete these docs would let them reset their own daily/monthly AI spend caps.
      // (They hold only counts and cost, no personal content, and are kept on account deletion.)
      allow read: if coll in ['ai_usage', 'ai_usage_daily', 'ai_usage_monthly'] && ownsExisting(docId);
    }
  }
}
