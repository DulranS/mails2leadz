rules_version = '2';

// Every customer can only see and change their own data. A team member invited by the owner works inside the owner's data with a
// role (see "Team logins" below); the original owner-only rules are kept in firestore.rules.v31-owner-only for rollback.
// Server API routes use the Firebase Admin SDK, which bypasses these rules, so the
// browser never needs broader access than this.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The server's own identity when it runs WITHOUT a service-account key ("server login", DEPLOYMENT_GUIDE.md): paste the
    // Firebase Authentication user id (UID) of the dedicated server user between the quotes, then republish these rules.
    // Left as it is, it matches nobody, so the rules stay exactly as locked down as before.
    function isServer() { return request.auth != null && request.auth.uid == 'PASTE_SERVER_USER_UID_HERE'; }
    function uid() { return request.auth.uid; }

    // A document belongs to the caller if it says so, or its id is "<uid>_<something>".
    function ownsExisting(docId) {
      return signedIn() && (
        resource.data.get('userId', '') == uid() ||
        resource.data.get('createdBy', '') == uid() ||
        docId.matches('^' + uid() + '_.*')
      );
    }
    function ownsNew(docId) {
      return signedIn() && (
        request.resource.data.get('userId', '') == uid() ||
        request.resource.data.get('createdBy', '') == uid() ||
        docId.matches('^' + uid() + '_.*')
      );
    }

    // ---- Team logins -------------------------------------------------------------------------------------------------------
    // A person invited to someone's workspace signs in with their OWN account. The server records them in the owner's roster at
    // users/{owner}/team_access/{member} (server-written; nobody can add themselves). These rules look for that record, so removing a
    // person ends their access at once. A 'manager' may read and write the owner's data; a 'viewer' may only read. The owner's own
    // access above is unchanged and is checked first.
    function teamOf(ownerId) {
      return signedIn() && ownerId is string && ownerId != '' &&
        exists(/databases/$(database)/documents/users/$(ownerId)/team_access/$(request.auth.uid));
    }
    function teamWrites(ownerId) {
      return teamOf(ownerId) &&
        get(/databases/$(database)/documents/users/$(ownerId)/team_access/$(request.auth.uid)).data.get('role', 'viewer') == 'manager';
    }
    function membersRead(docId) {
      return teamOf(resource.data.get('userId', '')) || teamOf(resource.data.get('createdBy', '')) || teamOf(docId.split('_')[0]);
    }
    function membersWrite(docId) {
      return teamWrites(resource.data.get('userId', '')) || teamWrites(resource.data.get('createdBy', '')) || teamWrites(docId.split('_')[0]);
    }
    function membersCreate(docId) {
      return teamWrites(request.resource.data.get('userId', '')) || teamWrites(request.resource.data.get('createdBy', '')) || teamWrites(docId.split('_')[0]);
    }
    // A member may change a document but never hand it to a different owner.
    function membersUpdate(docId) {
      return membersWrite(docId) && (
        request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
        request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
      );
    }

    // The dedicated server user (server login) may read and write everything. Nobody else gets anything from this.
    match /{document=**} {
      allow read, write: if isServer();
    }

    // Everything under users/{uid}/... (settings, follow-up tasks, notes, contacts)
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      allow read: if teamOf(userId);
      match /{sub=**} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Team members inside the owner's workspace. Never the roster (team_access), never the enquiry / ingest keys, and never the owner's
    // money-and-people records: salaries and payroll, loans, assets, bills, contracts and what is paid to partners.
    match /users/{userId}/settings/{docName} {
      allow read: if teamOf(userId) && !(docName in ['ingest_key', 'inbound_key', 'workspace']);
      allow write: if teamWrites(userId) && !(docName in ['ingest_key', 'inbound_key', 'workspace']);
    }
    match /users/{userId}/{coll}/{rest=**} {
      allow read: if teamOf(userId) && !(coll in ['settings', 'team_access', 'employees', 'payroll_inputs', 'payroll_months', 'loans', 'assets', 'bills', 'contracts', 'partner_payouts']);
      allow write: if teamWrites(userId) && !(coll in ['settings', 'team_access', 'employees', 'payroll_inputs', 'payroll_months', 'loans', 'assets', 'bills', 'contracts', 'partner_payouts']);
    }

    // Collections the signed-in user reads and writes directly from the browser.
    match /{coll}/{docId} {
      allow read: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox', 'suppressions',
          'draft_queue', 'autopilot_users', 'autosend_log', 'inbound_enquiries', 'reply_notices', 'finder_jobs'
        ] && (ownsExisting(docId) || membersRead(docId));
      allow delete: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox', 'suppressions',
          'draft_queue', 'autopilot_users', 'autosend_log', 'inbound_enquiries', 'reply_notices', 'finder_jobs'
        ] && (ownsExisting(docId) || membersWrite(docId));

      // 'suppressions' (opt-outs), 'draft_queue' (prepared drafts), 'autopilot_users', 'autosend_log' (how many emails Autosend sent per day) and 'inbound_enquiries' (public form submissions) and 'reply_notices', 'finder_jobs' (the lead finder's queue: the server fetches from it, so no browser may edit it), 'tenants' (plan standing) and 'admin_audit' (operator actions) are deliberately NOT in the create/update lists below: only the server writes them.
      allow create: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox'
        ] && (ownsNew(docId) || membersCreate(docId));

      // Updates may not hand the document to somebody else.
      allow update: if coll in [
          'deals', 'sent_emails', 'contacted_companies', 'campaigns', 'calls', 'sms_sent',
          'whatsapp_sent', 'whatsapp_contacts', 'replies', 'manual_contact_status',
          'contact_history', 'company_research', 'ai_smart_outreach', 'sent_leads',
          'send_time_optimization', 'clicks', 'ab_results', 'daily_metrics', 'backups',
          'scheduled_followups', 'targets', 'contacts', 'sms_qualifications', 'invoices', 'lead_inbox'
        ] && ((ownsExisting(docId) && ownsNew(docId)) || membersUpdate(docId));

      // AI usage is written only by the server and is READ-ONLY for users. Letting a user
      // delete these docs would let them reset their own daily/monthly AI spend caps.
      // (They hold only counts and cost, no personal content, and are kept on account deletion.)
      allow read: if coll in ['ai_usage', 'ai_usage_daily', 'ai_usage_monthly'] && (ownsExisting(docId) || membersRead(docId));
    }
  }
}
