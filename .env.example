# AutoLeads - copy to .env.local and fill in. Never commit .env* files.

# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server): the whole service-account JSON on one line ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google OAuth / Gmail ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side only. Do NOT use a NEXT_PUBLIC_ prefix for the secret: it would be shipped to every browser.
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# Optional: leave empty to send from the signed-in Gmail account
GMAIL_SENDER_EMAIL=

# --- App ---
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=AutoLeads
NEXT_PUBLIC_CONTACT_EMAIL=
# Comma-separated owner emails allowed to use /api/email-debug and /api/cache-clear
ADMIN_EMAILS=
# Digits only (94, 44, 1): used for local numbers starting with 0
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=94

# --- AI (DeepSeek default; OpenAI/Anthropic optional fallback) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_DAILY_CALL_LIMIT=
AI_MONTHLY_BUDGET_USD=
# AI_MODEL_FAST_DEEPSEEK=   # set if the default model name is rejected

# --- Opt-out links in every email (strongly recommended) ---
# A long random string used to sign the unsubscribe links. If empty, WEBHOOK_SECRET is used.
# Needs NEXT_PUBLIC_BASE_URL to be your https domain and FIREBASE_SERVICE_ACCOUNT_JSON to be set.
UNSUBSCRIBE_SECRET=

# --- Twilio (optional: SMS + calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEBHOOK_SECRET=
TWILIO_RECORD_CALLS=false

# --- Optional cache ---
REDIS_URL=
