# AutoLeads - copy to .env.local and fill in. Never commit .env* files.

# --- Firebase (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server): the whole service-account JSON (as downloaded, on one line, in quotes or base64: all are read) ---
# On Google's own hosting (Firebase App Hosting, Cloud Run, Cloud Functions) leave this empty: firebase-admin uses the host's default credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# ... OR, if your project does not let you create service-account keys, "server login" (no key): a dedicated Firebase Authentication
# email/password user the server signs in as. Create the user in Firebase console > Authentication, enable the Email/Password provider,
# paste the user's UID into firestore.rules (isServer) and republish. Ignored when FIREBASE_SERVICE_ACCOUNT_JSON is set. DEPLOYMENT_GUIDE.md has the steps.
FIREBASE_SERVER_EMAIL=
FIREBASE_SERVER_PASSWORD=

# --- Google OAuth / Gmail ---
# Sending and reading Gmail needs NONE of these: the Gmail permission comes from your Firebase Google sign-in (enable the Gmail API in Google Cloud).
# They are only for (a) the automatic overnight Gmail features and (b) sending from a different Gmail than the one you signed in with.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Server-side only. Do NOT use a NEXT_PUBLIC_ prefix for the secret: it would be shipped to every browser.
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# Optional: leave empty to send from the signed-in Gmail account
GMAIL_SENDER_EMAIL=

# --- App ---
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=AutoLeads
NEXT_PUBLIC_CONTACT_EMAIL=
# Lead finder (all optional). The free OpenStreetMap servers ask callers to identify themselves: NEXT_PUBLIC_CONTACT_EMAIL above goes in the
# User-Agent. Per-account daily limits (defaults shown); NOMINATIM_URL / OVERPASS_URL only if you run your own map servers.
# FINDER_DAILY_SEARCHES=12
# FINDER_DAILY_SITES=500
# NOMINATIM_URL=
# OVERPASS_URL=
# Comma-separated owner emails allowed to use /api/email-debug and /api/cache-clear (they always get in, even when the invite list is on)
ADMIN_EMAILS=
# Invite list. Comma-separated customer emails and/or @company.com domains. EMPTY = anyone with a Google account can sign in and
# use AI paid from YOUR key. Set it before you share the link.
ALLOWED_EMAILS=
# Digits only (94, 44, 1): used for local numbers starting with 0
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=94

# --- AI (DeepSeek default; OpenAI/Anthropic optional fallback) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Default 100 calls per customer per day (a draft costs a fraction of a cent)
AI_DAILY_CALL_LIMIT=
AI_MONTHLY_BUDGET_USD=
# AI_MODEL_FAST_DEEPSEEK=   # set if the default model name is rejected

# --- Opt-out links in every email (strongly recommended) ---
# A long random string used to sign the unsubscribe links. If empty, WEBHOOK_SECRET is used.
# Needs NEXT_PUBLIC_BASE_URL to be your https domain and FIREBASE_SERVICE_ACCOUNT_JSON to be set.
UNSUBSCRIBE_SECRET=

# --- Selling it as SaaS (optional; leave ALL of this unset for our own internal use) ---
# SAAS_MODE=on turns on plans, trials, limits and the subscription UI. Off/unset = every account is internal and unlimited.
SAAS_MODE=
# Accounts that are NEVER limited or put on a trial (comma-separated emails). ADMIN_EMAILS are also treated as internal.
INTERNAL_EMAILS=
# Stripe (subscriptions for the software). Create two recurring prices in Stripe and paste their ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# Optional: tune plan limits without code. Example: {"starter":{"limits":{"emailsPerDay":150},"features":{"offlineGmail":true}}}
PLAN_OVERRIDES_JSON=
# Optional: per-account request brake (default 600 a minute, 0 = off).
API_RATE_LIMIT_PER_MIN=

# --- Automatic reply checking while you are away (optional) ---
# 64 hex characters (openssl rand -hex 32). Encrypts the saved read-only Gmail access key. KEEP IT: if it changes, owners must reconnect.
TOKEN_ENC_KEY=
# Optional: only if the app's public address differs from the one in NEXT_PUBLIC_BASE_URL. Must be registered in Google Cloud.
GMAIL_OFFLINE_REDIRECT_URI=

# --- Overnight drafts (optional) ---
# A long random string. The host's scheduler sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/prepare-drafts
# (vercel.json already schedules it). Without it, drafts are still prepared when new leads arrive and on "Prepare now".
CRON_SECRET=

# --- Twilio (optional: SMS + calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEBHOOK_SECRET=
TWILIO_RECORD_CALLS=false

# --- Optional cache ---
REDIS_URL=
