# AutoLeads - environment variables. Copy to .env.local (local) or set on your host (production).
# Never commit real values. Anything starting with NEXT_PUBLIC_ is visible in the browser: no secrets there.

# ---- Firebase (client config: Firebase console > Project settings > Your apps) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (REQUIRED in production) ----
# One line of JSON from Firebase console > Project settings > Service accounts > Generate new private key.
# Without it the server cannot write AI usage counters, so AI spend caps cannot be enforced durably.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Google sign-in + Gmail sending ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=            # server-side only, NO NEXT_PUBLIC_ prefix
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/callback
GMAIL_SENDER_EMAIL=              # optional: the From address. If empty, Gmail uses the signed-in account

# ---- Public URL of this deployment ----
NEXT_PUBLIC_BASE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- AI ----
# DeepSeek is the default provider (cheapest, OpenAI-compatible). Set its key and you are done.
# Optional backups: if the primary provider is down and another key is set, the call falls back to it.
# Order: DEEPSEEK > OPENAI > ANTHROPIC. Force one with AI_PROVIDER=deepseek|openai|anthropic.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=deepseek
# Cost controls (defaults shown). Each customer is capped per day and per month, BEFORE money is spent.
AI_DAILY_CALL_LIMIT=60
AI_MONTHLY_BUDGET_USD=5
# Optional model overrides (cheap model for drafting, smarter one for harder work).
# Confirm current names in your DeepSeek console: a retired name never needs a code change.
# AI_MODEL_FAST_DEEPSEEK=deepseek-flash
# AI_MODEL_SMART_DEEPSEEK=deepseek-v4-pro
# AI_MODEL_FAST=gpt-4o-mini
# AI_MODEL_SMART=gpt-4o
# Optional: price overrides for the budget caps, USD per 1M tokens [input, output, cached-input]
# AI_PRICE_JSON={"deepseek-flash":[0.3,1.2,0.006]}

# ---- Admin access (comma-separated emails allowed to use admin-only routes) ----
ADMIN_EMAILS=you@example.com

# ---- Optional channels (leave empty to disable) ----
WEBHOOK_SECRET=                  # shared secret for the call/SMS webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
REDIS_URL=
