# Copy this file to .env.local and fill in your Firebase project's web config.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Your production URL (no trailing slash) — e.g. https://app.yourdomain.com.
# Used only for metadata: resolving the landing page's og:image/twitter:image
# to an absolute URL (app/layout.tsx, app/opengraph-image.tsx), the sitemap
# (app/sitemap.ts), and robots.txt's Sitemap: line (app/robots.ts). Falls
# back to http://localhost:3000 when unset, so this is safe to leave blank
# in local dev — set it for real once you have a production domain.
NEXT_PUBLIC_SITE_URL=

# --- Admin console passcode (/admin/new-business + app/api/admin/*) ---
# SERVER-SIDE ONLY. Do NOT give this a NEXT_PUBLIC_ prefix: Next.js inlines
# NEXT_PUBLIC_* values into the browser bundle, which would hand the passcode
# to every customer (they could then list, suspend or re-bill other
# businesses). If you ever deployed with NEXT_PUBLIC_ADMIN_PASSCODE, treat
# that value as leaked: pick a NEW value here and delete the old variable.
# Use a different value per deployment, never commit it, and rotate by
# changing it and redeploying.
ADMIN_PASSCODE=

# ADMIN_NOTIFICATION_EMAIL (above) is optional: blank, new leads / feedback / the morning digest go to
# NEXT_PUBLIC_SUPPORT_EMAIL instead. NEXT_PUBLIC_SITE_URL is optional on Vercel (its production domain is
# used); elsewhere set it so email links and the sitemap point at the right address.
#
# --- Customer support contact (shown on Settings -> Account and on the
#     suspended-account screen) ---
# PUBLIC on purpose (NEXT_PUBLIC_ is correct here — it's meant to be seen).
# This is how a customer whose trial ended or renewal is due actually reaches
# you, since billing is manual. WhatsApp number in international format
# (digits only, e.g. 94771234567; a local 077... number is converted for you). Set either or both; leave blank to hide.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Country code added to local numbers that start with 0 when building WhatsApp links
# (customer numbers on invoices and the support number). Default 94 (Sri Lanka).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=94
NEXT_PUBLIC_SUPPORT_EMAIL=
# The promise you make about how fast you answer, shown above the contact links,
# e.g. "We reply within one working day (Mon-Fri, 9am-6pm Sri Lanka time)". Only
# promise what you can keep. Leave blank to omit.
NEXT_PUBLIC_SUPPORT_RESPONSE_TIME=

# --- One-tap demo ("Try it now" on the landing + login pages) ---
# There is NO shared password any more: the button asks the server for a one-time sign-in
# token (POST /api/demo/session), so nothing secret ships in the page and a visitor can't
# change a password and lock everyone else out. DEMO_EMAIL is only how the SERVER finds the
# demo business the first time. That business MUST be plan "Demo" + complimentary (what
# Admin -> New business -> "Create demo business" makes) or the demo refuses to open -- so
# pointing this at a real customer's account does nothing harmful. Server-only (no NEXT_PUBLIC_);
# NEXT_PUBLIC_DEMO_EMAIL is still read if you already set it. NEXT_PUBLIC_DEMO_PASSWORD is no
# longer used and can be deleted.
# The shared demo is put back to its sample data automatically after it has been used and left
# idle, and once a day (needs the daily cron + CRON_SECRET), and on demand from the admin panel.
DEMO_EMAIL=
# How long a tap on "Try it now" stays signed in before the visitor is sent back
# to the landing page (minutes; default 30). The session also ends as soon as the
# tab or browser is closed, whatever this is set to.
NEXT_PUBLIC_DEMO_SESSION_MINUTES=

# --- How customers pay (manual billing) ---
# One line, e.g. "Bank transfer to Syndicate Software Solutions, Commercial Bank
# 1234567890, Pita Kotte branch — quote your business name as the reference".
# It is added to every payment reminder you copy/email from the admin panel and
# shown under "How to pay" on the owner's Your plan card when a renewal or trial
# is near. Public by design (it is what you'd tell any customer); never put a
# card number or a password here. Leave blank to omit.
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS=

# --- AI Assistant (natural-language query, natural-language data entry) —
#     app/api/ai/*, contexts/AiAssistantContext.tsx ---
# All three variables below are SERVER-SIDE ONLY. Set them in your
# deployment's environment variables (never with a NEXT_PUBLIC_ prefix, and
# never commit real values) — they must never reach the browser bundle.

# DeepSeek API key. platform.deepseek.com -> API Keys.
# The assistant calls DeepSeek Flash (deepseek-flash; override with AI_MODEL) through
# DeepSeek's Anthropic-compatible endpoint — chosen because every call this
# feature makes is a bounded, mechanical task (classify a request, phrase
# an already-computed number) rather than open-ended reasoning, so a
# budget-tier model's accuracy is more than sufficient, at roughly a fifth
# of Claude Haiku 4.5's per-token cost.
DEEPSEEK_API_KEY=
# Comma-separated business ids (the owner's own businesses) that use DEEPSEEK_API_KEY. Every other business uses its own key on Integrations.
AI_OPERATOR_BUSINESS_IDS=
# Optional. Overrides the model name if DeepSeek renames it (default: deepseek-flash).
# AI_MODEL=
# Optional. USD per million tokens, used ONLY for the "AI this month ~$" estimate in Admin. The
# defaults are DeepSeek Flash's peak list prices (checked 3 Oct 2026), so the estimate errs high.
# Set these only if the provider's price changes.
# AI_PRICE_INPUT=0.3
# AI_PRICE_OUTPUT=1.2
# AI_PRICE_CACHED=0.006

# Firebase Admin service account, used by app/api/ai/* to verify the
# caller's ID token and read/write Firestore server-side (see
# lib/firebaseAdmin.ts). Firebase Console -> Project settings -> Service
# accounts -> Generate new private key, which downloads a JSON file
# containing these three fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key field from the downloaded JSON exactly as-is,
# including the literal \n sequences and the BEGIN/END PRIVATE KEY lines —
# lib/firebaseAdmin.ts un-escapes them back into a real PEM at startup.
FIREBASE_PRIVATE_KEY=

# --- Trial request notifications (optional) — app/api/trial-requests,
#     lib/email.ts ---
# When someone submits the public "Request a trial" form (app/request-
# trial/page.tsx), ping a real inbox instead of relying on someone
# remembering to check the "Trial requests" tab in /admin/new-business.
# Leave all three blank and requests still save and show up in that tab
# exactly as before — just without an email nudge.
#
# Uses Resend (resend.com) over a plain HTTPS call, no SDK dependency
# added. Their free tier covers this easily — it's one email per trial
# request, not marketing volume.
RESEND_API_KEY=
# Must be a verified sending address/domain in your Resend account (or
# their onboarding@resend.dev sandbox address while testing).
TRIAL_NOTIFICATION_FROM_EMAIL=
# Where the notification goes — whoever handles new trial requests day to
# day. Can be the same inbox you use for ADMIN_PASSCODE-gated
# account creation, or a shared one.
ADMIN_NOTIFICATION_EMAIL=

# These same three vars ALSO switch on the automatic CUSTOMER emails (lib/lifecycle.ts):
# the welcome email with a set-password link when you activate an account, the receipt
# when you record a payment, "your trial was extended" / "your account is back on", and
# the reminders 3 days before a trial ends and 7 days before a renewal. With them blank
# none of that is sent — activation still works and falls back to Firebase's standard
# password-reset email, and you chase renewals by hand from the admin panel.
# FROM must be a verified sending address on YOUR domain for customer emails to land in
# inboxes rather than spam (the onboarding@resend.dev sandbox only delivers to you).
#
# The same three vars above also power notifications for
# app/api/feedback (the "Request something" / "Report a problem" widget
# on the marketing site and inside the app — see
# components/FeedbackWidget.tsx). Nothing extra to configure: leave them
# set as they are and both pipelines use them, or leave them all blank
# and both still save every submission to Firestore — just without the
# email nudge.

# --- Daily automation (optional) — app/api/cron/daily, lib/dailyJob.ts ---
# Once a day the server sends each customer the reminder they are owed (trial ending,
# renewal due, overdue) and emails YOU one short digest (leads waiting, accounts that need
# you). It never locks, charges or changes an account. Switched on by setting a long random
# secret here (at least 16 characters, e.g. the output of `openssl rand -hex 24`).
# vercel.json already schedules it for 03:00 UTC (08:30 in Sri Lanka); Vercel sends this
# secret automatically. On any other host, point a free scheduler (cron-job.org, GitHub
# Actions, ...) at GET https://YOUR-SITE/api/cron/daily with the header
# "Authorization: Bearer <this secret>".
# Leave blank and the job STILL RUNS (open mode): the URL is then not trusted, so it runs at
# most once per ~20 hours, answers with no business data, and builds email links only from
# NEXT_PUBLIC_SITE_URL / Vercel's own domain. Set a secret to lock the URL down. Only a secret
# that is set but shorter than 16 characters switches the job off (503) - a typo, not a choice.
# The admin panel's "Today" tab shows whether it is on and when it last ran.
CRON_SECRET=

# --- Sign-in links (optional) — app/api/start, lib/signedToken.ts ---
# The "choose your password" link in the welcome email is OURS and stays valid for 7 days
# (Firebase's own link dies after about an hour and that can't be changed). It is signed with a
# secret; with this blank, one is derived from FIREBASE_PRIVATE_KEY, so there is normally
# nothing to set. Set it only if you want to be able to kill every link ever sent (change the
# value and redeploy). At least 16 random characters, e.g. `openssl rand -hex 24`.
LINK_SIGNING_SECRET=

# --- Instant activation (optional, OFF by default) — lib/autoActivate.ts ---
# Normally you press Activate on each trial request. Set this to true and a request that
# passes every safety check gets its account, trial and welcome email the moment it is
# submitted, with no one pressing anything. Anything it declines (a throwaway email domain,
# an address that already has a login, the daily cap reached, a lead you already replied to)
# stays in the normal queue for you. There is still no public sign-up: the account can only
# be entered through the link emailed to the address that was typed in.
# Needs the customer-email variables above (Resend) to be useful.
AUTO_ACTIVATE_TRIALS=
# Most accounts it may create in one UTC day (default 10, ceiling 200). Past that, leads wait for you.
AUTO_ACTIVATE_MAX_PER_DAY=
# Extra email domains to refuse, comma-separated (a list of common throwaway providers is built in).
BLOCKED_EMAIL_DOMAINS=

# --- Who may request a trial, and proving they own the inbox — lib/emailPolicy.ts ---
# By default ONLY Gmail addresses (gmail.com, googlemail.com) can request a trial, and every request
# must be confirmed by clicking a link emailed to that address before it reaches your queue — that
# click, not the address format, is what proves the inbox is theirs. Dots and "+tags" are ignored
# when deciding whether two Gmail addresses are the same person (john.doe@, johndoe+x@ and johndoe@
# gmail.com are ONE inbox = one trial).
# To allow other providers: a comma-separated list (e.g. gmail.com,outlook.com,yahoo.com), or * for any
# domain (the throwaway-mail block list above still applies). Leave blank for Gmail only.
TRIAL_EMAIL_DOMAINS=
# The confirmation link is built from this, not from the request's Origin header. Set it in
# production (it is already used for share images and the sitemap).
# NEXT_PUBLIC_SITE_URL=  (see the top of this file)

# --- Caps on emails a stranger can trigger — lib/emailBudget.ts ---
# Hard daily ceilings (UTC day), across everyone, on the public forms' emails: "confirm your email" /
# "you already have an account" (trial form) and the "someone left a note" nudge to your inbox (feedback).
# Past the cap nothing more is sent until tomorrow; the note itself is still saved. Welcome, receipt and
# reminder emails are never counted, so this can't stop a customer getting theirs. Leave blank for the
# defaults (60 and 30), which fit inside Resend's free 100-a-day plan.
PUBLIC_EMAIL_CONFIRM_MAX_PER_DAY=
PUBLIC_EMAIL_FEEDBACK_MAX_PER_DAY=

# --- Find prospects (Leads page) — lib/prospectSearch.ts ---
# The prospect finder uses the free OpenStreetMap services (no key, no account, no deposit). Their usage policy asks every
# app to identify itself, so set an email address that can reach whoever runs this deployment; it is sent only in the
# User-Agent of those lookups. Optional: leave blank and the app still works, but set it before real use.
OSM_CONTACT_EMAIL=

# --- SMS reminders (optional) -------------------------------------------------------------------------
# Overdue-invoice reminders by text message through Notify.lk (a Sri Lankan SMS gateway). All three are needed;
# blank = no texts are ever sent. The user id and API key are on your Notify.lk settings page. The sender name must be
# one Notify.lk has approved for your account (up to 11 characters); NotifyDEMO is for testing only and must not be
# used for real messages. A business also has to switch on "Also send a text message" in its own Settings.
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# Encrypts the owner-entered outside-service keys (Integrations page) before they are stored. 64 hex characters: openssl rand -hex 32.
# Set it before anyone saves a key. Keys saved before this was set stay readable and are encrypted the next time they are saved.
BALANCR_ENC_KEY=
